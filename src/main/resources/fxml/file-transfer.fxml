<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.peerchat.client.controller.FileTransferController"
      styleClass="terminal-panel" spacing="12" prefWidth="320.0">

    <padding>
        <Insets top="12" right="14" bottom="12" left="14"/>
    </padding>

    <!-- Tiêu đề -->
    <Label text="[ TRUYỀN DỮ LIỆU QUA SERVER ]" styleClass="panel-header"/>
    <Label text="Truyền file theo chunk 64KB, kiểm tra SHA-256." styleClass="telemetry-label"/>

    <!-- Người nhận đã chọn -->
    <VBox spacing="3">
        <Label text="Người nhận:" styleClass="telemetry-label"/>
        <Label fx:id="targetRecipientLabel" text="TẤT CẢ CLIENTS (GỬI CHUNG)"
               styleClass="telemetry-value-warn" wrapText="true"/>
    </VBox>

    <!-- File đã chọn -->
    <VBox spacing="3">
        <Label text="File đã chọn:" styleClass="telemetry-label"/>
        <Label fx:id="stagedFileLabel" text="Chưa chọn file nào"
               styleClass="telemetry-value-cyan" wrapText="true"/>
    </VBox>

    <!-- Nút chọn file -->
    <Button fx:id="selectFileButton" text="CHỌN FILE TỪ MÁY..." onAction="#handleSelectFile" maxWidth="Infinity"/>

    <!-- Tiến độ và tốc độ -->
    <VBox spacing="6">
        <HBox alignment="CENTER_LEFT">
            <Label text="Tiến độ truyền:" styleClass="telemetry-label"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="speedLabel" text="0.0 KB/s" styleClass="telemetry-value-nominal"/>
        </HBox>

        <ProgressBar fx:id="transferProgressBar" progress="0.0" maxWidth="Infinity"/>
        <Label fx:id="statusLabel" text="SẴN SÀNG" styleClass="telemetry-label" wrapText="true"/>
    </VBox>

    <!-- Kết quả kiểm tra tính toàn vẹn SHA-256 -->
    <VBox spacing="3">
        <Label text="Kiểm tra toàn vẹn SHA-256:" styleClass="telemetry-label"/>
        <Label fx:id="checksumLabel" text="[Chờ truyền file]" styleClass="telemetry-value-nominal" wrapText="true"/>
    </VBox>

    <!-- Nút bấm hành động -->
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="abortButton" text="HỦY BỎ" onAction="#handleAbort" styleClass="button-danger" disable="true"/>
        <Button fx:id="sendButton" text="GỬI FILE" onAction="#handleSendFile" styleClass="button-action" disable="true"/>
    </HBox>
</VBox>
