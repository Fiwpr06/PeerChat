<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="repoRootPanel"
      fx:controller="com.peerchat.client.controller.FileTransferController"
      styleClass="terminal-panel" spacing="8" prefWidth="300.0">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Tiêu đề Kho tài liệu và nút đóng -->
    <HBox alignment="CENTER_LEFT" spacing="6">
        <Label text="[ KHO TÀI LIỆU PHÒNG ]" styleClass="panel-header"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="fileCountBadge" text="0 TỆP" styleClass="telemetry-value-cyan"/>
        <Button text="✕" onAction="#handleClosePanel" styleClass="button" prefWidth="26.0" prefHeight="22.0"/>
    </HBox>

    <Label text="Kéo thả tập tin vào chat để tải lên" styleClass="telemetry-label"/>

    <!-- Danh sách file đã chia sẻ -->
    <ListView fx:id="sharedFilesListView" VBox.vgrow="ALWAYS"/>

    <!-- Khối giám sát tiến độ tải / gửi file -->
    <VBox spacing="4" styleClass="hud-status-bar">
        <padding>
            <Insets top="6" right="8" bottom="6" left="8"/>
        </padding>
        <HBox alignment="CENTER_LEFT">
            <Label text="Tiến độ truyền tải:" styleClass="telemetry-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="speedLabel" text="0.0 KB/s" styleClass="telemetry-value-nominal"/>
        </HBox>
        <ProgressBar fx:id="transferProgressBar" progress="0.0" maxWidth="Infinity"/>
        <Label fx:id="statusLabel" text="SẴN SÀNG" styleClass="telemetry-label" wrapText="true"/>
        <Label fx:id="checksumLabel" text="SHA-256: [Chờ truyền]" styleClass="telemetry-value-nominal" wrapText="true"/>
    </VBox>
</VBox>

