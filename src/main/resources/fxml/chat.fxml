<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.peerchat.client.controller.ChatController"
            prefWidth="1080.0" prefHeight="720.0"
            stylesheets="@../css/style.css">

    <!-- Thanh tiêu đề phía trên -->
    <top>
        <HBox styleClass="hud-bar" spacing="16" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8" right="16" bottom="8" left="16"/>
            </padding>
            <Label text="PEERCHAT // GIAO TIẾP VÀ TRUYỀN FILE" styleClass="hud-title"/>
            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Tên của bạn:" styleClass="telemetry-label"/>
            <Label fx:id="nodeCallsignLabel" text="OPERATOR" styleClass="telemetry-value-cyan"/>

            <Label text="Server:" styleClass="telemetry-label"/>
            <Label fx:id="serverCoordinatesLabel" text="127.0.0.1:5000" styleClass="telemetry-value-nominal"/>

            <Label text="Trạng thái:" styleClass="telemetry-label"/>
            <Label fx:id="carrierStatusLabel" text="ĐÃ KẾT NỐI" styleClass="telemetry-value-nominal"/>

            <Button text="NGẮT KẾT NỐI" onAction="#handleDisconnect" styleClass="button-danger"/>
        </HBox>
    </top>

    <!-- Khu vực làm việc chính 3 cột -->
    <center>
        <SplitPane dividerPositions="0.25, 0.70">
            <!-- Cột trái: Danh sách Client đang online -->
            <VBox styleClass="terminal-panel" spacing="8">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <HBox alignment="CENTER_LEFT">
                    <Label text="[ DANH SÁCH TRỰC TUYẾN ]" styleClass="panel-header"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="peerCountLabel" text="0 ONLINE" styleClass="telemetry-value-nominal"/>
                </HBox>

                <Button fx:id="broadcastButton" text="GỬI TẤT CẢ (BROADCAST)" onAction="#handleSelectBroadcast"
                        maxWidth="Infinity" styleClass="button-action"/>

                <Label text="Chọn người nhận trực tiếp:" styleClass="telemetry-label"/>
                <ListView fx:id="peersListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Cột giữa: Luồng tin nhắn chat và ô nhập -->
            <VBox spacing="8">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <!-- Người nhận hiện tại -->
                <HBox alignment="CENTER_LEFT" styleClass="hud-bar">
                    <padding>
                        <Insets top="6" right="10" bottom="6" left="10"/>
                    </padding>
                    <Label text="Kênh nhắn tin:" styleClass="telemetry-label"/>
                    <Region prefWidth="10"/>
                    <Label fx:id="channelTargetLabel" text="TẤT CẢ (GỬI CHUNG)" styleClass="telemetry-value-cyan"/>
                </HBox>

                <!-- Danh sách tin nhắn cuộn -->
                <ScrollPane fx:id="chatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
                    <VBox fx:id="messagesContainer" spacing="8">
                        <padding>
                            <Insets top="8" right="8" bottom="8" left="8"/>
                        </padding>
                    </VBox>
                </ScrollPane>

                <!-- Ô nhập tin nhắn và nút gửi -->
                <HBox spacing="8" alignment="CENTER">
                    <TextField fx:id="messageInputField" promptText="Nhập nội dung tin nhắn..." HBox.hgrow="ALWAYS" onAction="#handleSendMessage"/>
                    <Button fx:id="sendButton" text="GỬI TIN NHẮN" onAction="#handleSendMessage" styleClass="button-action" prefWidth="130.0"/>
                </HBox>
            </VBox>

            <!-- Cột phải: Module truyền file qua server -->
            <fx:include fx:id="fileTransfer" source="file-transfer.fxml"/>
        </SplitPane>
    </center>

    <!-- Thanh trạng thái dưới cùng -->
    <bottom>
        <HBox styleClass="hud-status-bar" spacing="20" alignment="CENTER_LEFT">
            <padding>
                <Insets top="6" right="16" bottom="6" left="16"/>
            </padding>
            <Label text="Trạng thái: Ổn định" styleClass="telemetry-value-nominal"/>
            <Label text="Bảo toàn dữ liệu: SHA-256 Checksum" styleClass="telemetry-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="systemClockLabel" text="00:00:00" styleClass="telemetry-label"/>
        </HBox>
    </bottom>
</BorderPane>
