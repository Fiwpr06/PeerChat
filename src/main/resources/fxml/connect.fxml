<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.peerchat.client.controller.ConnectController"
            prefWidth="720.0" prefHeight="540.0"
            stylesheets="@../css/style.css">

    <!-- Thanh tiêu đề phía trên -->
    <top>
        <HBox styleClass="hud-bar" spacing="12" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Label text="PEERCHAT // HỆ THỐNG GIAO TIẾP &amp; TRUYỀN FILE" styleClass="hud-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="GIAO THỨC:" styleClass="telemetry-label"/>
            <Label text="TCP SOCKET" styleClass="telemetry-value-nominal"/>
        </HBox>
    </top>

    <!-- Khung nhập thông tin kết nối -->
    <center>
        <VBox alignment="CENTER" spacing="18" fillWidth="false">
            <VBox styleClass="terminal-panel" prefWidth="480.0" spacing="14">
                <padding>
                    <Insets top="20" right="24" bottom="20" left="24"/>
                </padding>

                <!-- Tiêu đề form -->
                <Label text="KẾT NỐI SERVER" styleClass="panel-header"/>
                <Label text="Nhập địa chỉ IP, cổng và mã phiên do Server cung cấp để tham gia." styleClass="telemetry-label"/>

                <!-- Địa chỉ IP / Host -->
                <VBox spacing="4">
                    <Label text="Địa chỉ IP Server (Localhost / LAN):" styleClass="telemetry-label"/>
                    <TextField fx:id="hostField" promptText="127.0.0.1" text="127.0.0.1"/>
                </VBox>

                <!-- Cổng Port -->
                <VBox spacing="4">
                    <Label text="Cổng Port (Mặc định: 5000):" styleClass="telemetry-label"/>
                    <TextField fx:id="portField" promptText="5000" text="5000"/>
                </VBox>

                <!-- Mã kết nối Connection Code -->
                <VBox spacing="4">
                    <Label text="Mã kết nối Server (Connection Code 5 ký tự):" styleClass="telemetry-label"/>
                    <TextField fx:id="codeField" promptText="Nhập mã từ console Server (ví dụ: A7X2K)"/>
                </VBox>

                <!-- Tên hiển thị -->
                <VBox spacing="4">
                    <Label text="Tên hiển thị (Display Name):" styleClass="telemetry-label"/>
                    <TextField fx:id="nameField" promptText="Nhập tên của bạn" text="Alice"/>
                </VBox>

                <!-- Trạng thái kết nối -->
                <Label fx:id="statusLabel" text="Sẵn sàng kết nối..." styleClass="telemetry-value-cyan" wrapText="true"/>

                <!-- Nút kết nối -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <padding>
                        <Insets top="6"/>
                    </padding>
                    <Button fx:id="connectButton" text="KẾT NỐI SERVER" onAction="#handleConnect"
                            styleClass="button-action" defaultButton="true" prefWidth="200.0"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Thanh trạng thái phía dưới -->
    <bottom>
        <HBox styleClass="hud-status-bar" spacing="16">
            <padding>
                <Insets top="6" right="16" bottom="6" left="16"/>
            </padding>
            <Label text="Mô hình: Client-Server TCP Socket" styleClass="telemetry-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Đồ án Network Programming" styleClass="telemetry-label"/>
        </HBox>
    </bottom>
</BorderPane>
